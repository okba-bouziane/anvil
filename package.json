{
  "name": "anvil",
  "productName": "Anvil",
  "version": "0.3.0",
  "description": "A code editor with an optional AI agent that keeps working with no internet",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/file-icons.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/file-icons.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --mac dir -c.npmRebuild=false && codesign --force --deep --sign - dist/mac-*/Anvil.app",
    "postinstall": "node scripts/postinstall.cjs",
    "dist:win": "npm run build && electron-builder --win --publish never -c.npmRebuild=false",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "dev.okba.anvil",
    "extraResources": [
      {
        "from": "resources/js-debug",
        "to": "js-debug"
      }
    ],
    "files": [
      "out/**",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/pyright/**",
      "node_modules/@angular/language-server/**",
      "node_modules/@angular/language-service/**",
      "node_modules/typescript/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Okba Bouziane"
    },
    "artifactName": "Anvil-${os}-${arch}.${ext}",
    "electronLanguages": [
      "en"
    ]
  },
  "dependencies": {
    "@angular/language-server": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "node-pty": "^1.1.0",
    "pyright": "^1.1.414",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "emmet-monaco-es": "^5.7.0",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.1.3",
    "material-icon-theme": "^5.40.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "license": "MIT",
  "author": "Okba Bouziane",
  "homepage": "https://github.com/okba-bouziane/anvil",
  "repository": {
    "type": "git",
    "url": "https://github.com/okba-bouziane/anvil.git"
  }
}
